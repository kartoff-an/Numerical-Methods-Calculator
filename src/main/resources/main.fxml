<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.roquero.numericalmethods.controllers.MainController"
            styleClass="root">

    <left>
        <VBox spacing="10" styleClass="nav-box" prefWidth="250">
            <fx:define>
                <ToggleGroup fx:id="methods"/>
            </fx:define>

            <Label text="Methods" styleClass="nav-brand" />

            <ToggleButton text="Newton–Raphson Method"
                          toggleGroup="$methods"
                          onAction="#openNewtonRaphson"
                          selected="true"
                          maxWidth="Infinity"/>
            <ToggleButton text="Gauss–Jacobi Method"
                          onAction="#openGaussJacobi"
                          toggleGroup="$methods"
                          maxWidth="Infinity"/>
            <ToggleButton text="Newton's Interpolation"
                          onAction="#openNewtonInterpolation"
                          toggleGroup="$methods"
                          maxWidth="Infinity"/>
            <ToggleButton text="Simpson's 1/3 Rule"
                          onAction="#openSimpson13"
                          toggleGroup="$methods"
                          maxWidth="Infinity"/>
            <ToggleButton text="Central Divided Difference"
                          onAction="#openCDD"
                          toggleGroup="$methods"
                          maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" style="-fx-padding: 15 0 15 0;">
                <Label text="Created by Rean Glenn Roquero"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 11px; -fx-font-weight: bold;"
                       alignment="CENTER"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-focus-color: transparent; -fx-faint-focus-color: transparent; -fx-background: #f5f7fb;">

            <VBox fx:id="workspace"
                  spacing="14"
                  alignment="TOP_CENTER"
                  style="-fx-background-color: #f5f7fb;"/>

        </ScrollPane>
    </center>

    <right>
        <VBox spacing="12"
              prefWidth="260"
              style="-fx-padding: 16; -fx-background-color: #ffffff; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 0 1;">

            <Label text="Settings" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <Separator />

            <!-- Decimal Places -->
            <VBox spacing="6">
                <Label text="Decimal Places" />
                <Spinner fx:id="decimalPlacesSpinner"
                         minWidth="120"
                         editable="true" />
            </VBox>

            <Separator />

            <!-- Rounding Mode -->
            <Label text="Rounding Mode" />

            <fx:define>
                <ToggleGroup fx:id="roundingModeGroup"/>
            </fx:define>

            <RadioButton fx:id="roundDisplayOnlyRadio"
                         text="No rounding"
                         toggleGroup="$roundingModeGroup" />

            <RadioButton fx:id="roundEachIterationRadio"
                         text="Round every iteration (HALF EVEN)"
                         toggleGroup="$roundingModeGroup"
                         selected="true" />

            <Region VBox.vgrow="ALWAYS" />

        </VBox>
    </right>
</BorderPane>